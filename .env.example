# ─── CrewBridge environment template ───────────────────────────────
# Copy to .env (server) / client/.env.local (client). Never commit real values.

# ── Client (Vite). Every VITE_* value is PUBLIC — it ships to the browser.
# API base path (default /api; production uses the Vercel → Render rewrite, so keep the default)
VITE_API_BASE=
# Dev only: where Vite proxies /api (default http://localhost:4000)
VITE_DEV_API_TARGET=
# (Nexconn needs no client variables: the browser gets the App Key, data center and a per-user
#  token from POST /api/chat/session.)

# ── Server (Render). NEVER prefix these with VITE_.
PORT=4000
# MongoDB Atlas connection string. Leave empty in development to use a temporary in-memory DB.
MONGODB_URI=
# ≥32 random characters (required in production): openssl rand -hex 32
JWT_SECRET=
# Allowed browser origin(s), comma-separated
CLIENT_ORIGIN=http://localhost:5173
# Optional: bcrypt cost (default 12) and the password `npm run seed` gives demo accounts
BCRYPT_ROUNDS=
# Proxy hops in front of the API (Vercel rewrite → Render = 2). Sets Express "trust proxy" for client IPs.
TRUST_PROXY=1
SEED_DEMO_PASSWORD=
# Nexconn chat (Milestone 4). Leave all three empty to run without messaging.
NEXCONN_APP_KEY=
# SECRET — server only. Never prefix with VITE_, never commit.
NEXCONN_APP_SECRET=
# Data center of your Nexconn app: SG | NA | SA | OM  (Singapore → SG, sent to the SDK as AreaCode.SG)
NEXCONN_AREA=SG
# Optional overrides. Defaults follow NEXCONN_AREA (SG: https://api.sg-light-api.com + api-b backup).
# Required for OM, which has no documented default host.
NEXCONN_API_BASE=
NEXCONN_API_BACKUP=
